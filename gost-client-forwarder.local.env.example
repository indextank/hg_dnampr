# gost-client-forwarder.sh 本机私有配置模板
# 用法：复制为 gost-client-forwarder.local.env（同目录，已被 .gitignore 忽略）
#   cp gost-client-forwarder.local.env.example gost-client-forwarder.local.env
#   chmod 600 gost-client-forwarder.local.env
#
# 优先级：命令行参数 > 本文件 > 脚本顶部 DEFAULT_* 默认值
# 本文件中列出的每一项都能覆盖脚本默认值；不写的项沿用脚本默认。

# ---------------------------------------------------------------
# 本地监听（对最终用户暴露的入口）
# ---------------------------------------------------------------
DEFAULT_LOCAL_HTTP_PORT=28080
DEFAULT_LOCAL_SOCKS_PORT=28081
# 监听地址：127.0.0.1 仅本机；0.0.0.0 所有网卡（需防火墙/安全组配合）
DEFAULT_LOCAL_BIND="127.0.0.1"
# 本地入口的认证账号；留空则复用已安装 state.env，否则随机生成
DEFAULT_LOCAL_USER=""
DEFAULT_LOCAL_PASS=""

# ---------------------------------------------------------------
# HTTP 本地入口的专用上游（留空表示不创建该条链）
# ---------------------------------------------------------------
DEFAULT_HTTP_UPSTREAM_HOST=""
DEFAULT_HTTP_UPSTREAM_PORT=""
DEFAULT_HTTP_UPSTREAM_USER=""
DEFAULT_HTTP_UPSTREAM_PASS=""
# 上游协议：http 或 socks5
DEFAULT_HTTP_UPSTREAM_PROXY_TYPE="http"

# ---------------------------------------------------------------
# SOCKS5 本地入口的专用上游（留空表示不创建该条链）
# ---------------------------------------------------------------
DEFAULT_SOCKS_UPSTREAM_HOST=""
DEFAULT_SOCKS_UPSTREAM_PORT=""
DEFAULT_SOCKS_UPSTREAM_USER=""
DEFAULT_SOCKS_UPSTREAM_PASS=""
DEFAULT_SOCKS_UPSTREAM_PROXY_TYPE="socks5"

# ---------------------------------------------------------------
# 传输层
# ---------------------------------------------------------------
# 上游传输：tcp / grpc / h3
DEFAULT_UPSTREAM_TRANSPORT="grpc"
DEFAULT_GRPC_PATH="/GostTunel/Tunnel"
DEFAULT_H3_AUTHORIZE_PATH="/authorize"
DEFAULT_H3_PUSH_PATH="/push"
DEFAULT_H3_PULL_PATH="/pull"

# ---------------------------------------------------------------
# 运维行为
# ---------------------------------------------------------------
# 每日定时重启时间（systemd OnCalendar 语法）
DEFAULT_RESTART_ON_CALENDAR="*-*-* 03:10:00"
# 1 = 自动写入 docker 代理配置并重启 docker；0 = 不处理
DEFAULT_AUTO_CONFIGURE_DOCKER=1

# ---------------------------------------------------------------
# 上游预检策略（见 AGENTS 文档 / --help）
# ---------------------------------------------------------------
# lenient：HTTP 组与 SOCKS 组至少完整配置一组；另一组可整体留空
# strict ：8 项（两组各 HOST/PORT/USER/PASS）必须全部非空
UPSTREAM_PRECHECK_MODE=lenient
# 1 = 上游 USER/PASS 必填；0 = 允许免认证上游，缺失仅告警
UPSTREAM_AUTH_REQUIRED=1
