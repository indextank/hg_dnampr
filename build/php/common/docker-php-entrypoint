#!/bin/sh
set -eu

# Runtime directories are pre-created in the image and provided as uid/gid
# aware tmpfs mounts by Compose.  The entrypoint deliberately performs no
# chown/chmod so the container can run with no capabilities as www-data.
for _php_runtime_dir in /tmp/php_sessions /tmp/php_upload /tmp/apache2/run; do
	if [ ! -d "${_php_runtime_dir}" ] || [ ! -w "${_php_runtime_dir}" ]; then
		echo "ERROR: PHP runtime directory is not writable: ${_php_runtime_dir}" >&2
		exit 1
	fi
done
unset _php_runtime_dir

# first arg is `-f` or `--some-option`
if [ "${1#-}" != "$1" ]; then
	set -- apache2-foreground "$@"
fi

exec "$@"
