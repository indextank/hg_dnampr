# ==========================================
# ELK Stack 生产环境配置（千万级数据量优化版）
# ==========================================
# 使用方式: ./up.sh elk prod
#
# 千万级规模说明
# ──────────────────────────────────────────
#   索引文档数  : 5000 万 +，平均文档 1–5 KB
#   预计磁盘占用: 50–200 GB（含副本）
#
# 关键设计原则
# ──────────────────────────────────────────
#   1. 容器内存限制必须 ≥ 2 × 堆大小
#      （堆外内存 + G1GC Region 池 + OS page cache + JVM 元数据）
#   2. Xms = Xmx，避免堆扩容/收缩引发 Full GC 停顿
#   3. 堆大小不超过 31 GB（超过则 JVM 关闭 Compressed OOPs，内存效率骤降）
#   4. Logstash workers = CPU 核数，batch.size 适当放大以提升写入吞吐
# ==========================================

# ------------------------------------------
# Elasticsearch 配置文件路径（生产环境专用）
# compose/stacks/elk.yaml 的 volumes 中通过 ${ELASTICSEARCH_YML_FILE} 引用此变量
# 生产环境：SSL 全开，5000 万级性能调优，启用内存锁定
# 路径由 derive_elk_conf_paths 按 ELK_BUILD_VERSION + 环境自动派生，无需在此硬编码

# ------------------------------------------
# 安全配置（生产环境：安全功能 + SSL 全部开启）
# ------------------------------------------
ELK_SECURITY_ENABLED=true
ELK_TRANSPORT_SSL_ENABLED=true
ELK_HTTP_SSL_ENABLED=true
KIBANA_NEEDS_AUTH=true
ELASTICSEARCH_PROTOCOL=https

# SSL 证书路径（由 generate-elk-certs.sh 生成）
ELK_SSL_CERTIFICATE_AUTHORITIES=/usr/share/kibana/certs/ca/ca.crt
ELK_SSL_CERTIFICATE=/usr/share/kibana/certs/elasticsearch/elasticsearch.crt
ELK_SSL_KEY=/usr/share/kibana/certs/elasticsearch/elasticsearch.key




# ==========================================
# Elasticsearch 千万级生产调优
# ==========================================
#
# 堆大小：8 GB
#   • 千万级场景下聚合缓冲、查询缓存、fielddata 合计约 3–5 GB
#   • 8 GB 提供充足余量并保持 Compressed OOPs
#
# G1GC 参数说明
#   -XX:G1ReservePercent=25
#       预留 25% 堆空间作为 G1 疏散缓冲，防止对象晋升失败触发 Full GC
#   -XX:InitiatingHeapOccupancyPercent=30
#       堆使用率达 30% 即触发并发标记（默认 45%），提前回收，
#       降低千万级写入洪峰时 GC 停顿风险
#   -XX:G1NewSizePercent=20
#       Young 区最小占比 20%，为高写入速率提供充足新生代空间
#   -XX:MaxGCPauseMillis=400
#       GC 停顿目标 400ms，平衡吞吐与延迟
#       （设置过低会增加 GC 频率，适得其反）
#
# 堆大小：16 GB
#   16 GB 堆下：
#     • fielddata 缓存 30% = 4.8 GB，足以容纳大型 terms/date_histogram 聚合
#     • request 熔断器 40% = 6.4 GB，应对复杂多层聚合
#     • G1 保留 25% = 4 GB，防疏散失败触发 Full GC
ES_JAVA_OPTS="-Xms16g -Xmx16g -XX:+UnlockExperimentalVMOptions -XX:G1ReservePercent=25 -XX:InitiatingHeapOccupancyPercent=30 -XX:G1NewSizePercent=20 -XX:MaxGCPauseMillis=400 -Xlog:gc*:file=/usr/share/elasticsearch/logs/gc.log:utctime,level,tags:filecount=8,filesize=128m"

ELASTICSEARCH_LOG_DIR=../../logs/elasticsearch/

# 【紧急】数据持久化路径 ——磁盘是当前最危险的瓶颈
# ─────────────────────────────────────────────────
# 当前宿主机系统盘仅剩 44 GB，5000 万文档压缩后约 20-50 GB，
# 加上多个千万级索引，预计数月内耗尽系统盘空间。
#
# 强烈建议：
#   1. 挂载独立高速 SSD（建议 500 GB+）作为 ES 数据目录
#   2. 取消注释下方路径并指向挂载点（例如 /data/elasticsearch）
#   3. 提前执行：sudo mkdir -p /data/elasticsearch
#              sudo chown -R 1000:1000 /data/elasticsearch
#
# !! 不配置此项则 ES 数据写入系统盘，系统盘写满将导致 ES 崩溃 !!
# 留空 → 由 Compose 运行时拼装：${DATA_PATH_HOST}/${ELASTICSEARCH_DATA_SUBDIR}（默认 /data/volume_data/elasticsearch）
# 填值 → 完全替换此路径（向后兼容）
ELASTICSEARCH_DATA_PATH=

# 内存限制：32 GB（= 2 × 16 GB 堆）
#   16 GB 堆 + ~6 GB G1GC 元数据/堆外 + ~10 GB OS page cache 余量
# !! 警告：将此值设为等于或小于堆大小会导致容器 OOM Kill !!
ELASTICSEARCH_MEMORY_LIMIT=32g
ELASTICSEARCH_MEMORY_RESERVATION=16g

# CPU：5000 万级并发查询 + 批量写入 + 后台 segment merge 需要 8 核
ELASTICSEARCH_CPU_LIMIT=8
ELASTICSEARCH_CPU_RESERVATION=4





# ==========================================
# Kibana 千万级生产调优
# ==========================================
#
# 千万级聚合可视化（如 date_histogram、terms 聚合）
# 返回结果集较大，Node.js 堆需要充足空间渲染。
# docker-compose 中已设置 NODE_OPTIONS="--max-old-space-size=2048"，
# 容器限制需高于该值。
#
KIBANA_MEMORY_LIMIT=3g
KIBANA_MEMORY_RESERVATION=1g
KIBANA_CPU_LIMIT=2
KIBANA_CPU_RESERVATION=0.5





# ==========================================
# Logstash 千万级生产调优
# ==========================================
#
# 堆大小：2 GB
#   处理高吞吐管道（批量解析 + 过滤 + 批量写入 ES）
#   每个 pipeline worker 约消耗 200–400 MB 堆
#
# LS_JAVA_OPTS="-Xms2g -Xmx2g"
# !! 注意：Xms = Xmx，同 ES 原则 !!
#
LS_JAVA_OPTS="-Xms2g -Xmx2g"

# 容器内存：3 GB（= 1.5 × 堆）
#   2 GB 堆 + ~0.5 GB JVM 堆外 + ~0.5 GB 管道内部缓冲
LOGSTASH_MEMORY_LIMIT=3g
LOGSTASH_MEMORY_RESERVATION=2g

# CPU：pipeline.workers = 4（建议与服务器 CPU 核数一致）
LOGSTASH_CPU_LIMIT=4
LOGSTASH_CPU_RESERVATION=1

# Pipeline 吞吐调优
#
#   LOGSTASH_WORKERS=4
#       并发 pipeline worker 数，决定并行处理能力
#       建议 = 服务器 vCPU 数（本配置按 4 核设定）
#
#   LOGSTASH_BATCH_SIZE=500
#       每次从输入拉取的最大事件数（默认 125）
#       批量越大，单次写入 ES 的文档越多，Bulk API 效率越高
#       千万级日志场景推荐 500–1000
#
#   LOGSTASH_BATCH_DELAY=50
#       批量等待超时（ms）：等待批次填满的最长时间
#       50ms 在延迟与吞吐之间取得平衡
#
LOGSTASH_WORKERS=4
LOGSTASH_BATCH_SIZE=500
LOGSTASH_BATCH_DELAY=50
