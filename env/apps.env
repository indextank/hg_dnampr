# ==========================================
# Spug配置（运维管理平台）
# ==========================================
# Spug访问端口
SPUG_PORT=8000

# Spug 数据持久化子目录名
# 完整路径 = ${DATA_PATH_HOST}/${SPUG_DATA_SUBDIR}（由 Compose 运行时拼装）
#   默认 → /data/volume_data/spug
# 整体迁移 → 仅修改 .env 中的 DATA_PATH_HOST 即可
# 如需整体替换完整路径，可在 .env 中显式覆盖 SPUG_DATA_DIR
SPUG_DATA_SUBDIR=spug

# 数据库引擎
SPUG_DB_ENGINE=mysql
# 数据库端口
SPUG_DB_PORT=3306
# 数据库名称
SPUG_DB_DATABASE=spug
# 数据库账号凭证（敏感凭证统一放在根目录 .env，此处不再定义避免覆盖）
# SPUG_DB_USER、SPUG_DB_PASSWORD 均在 .env 中配置

# ==========================================
# Gitea配置（Git代码托管平台）
# ==========================================
# 数据库引擎
GITEA_DB_ENGINE=mysql
# 数据库端口
GITEA_DB_PORT=3306
# 数据库名称
GITEA_DB_DATABASE=gitea
# 数据库账号凭证（敏感凭证统一放在根目录 .env，此处不再定义避免覆盖）
# GITEA_DB_USER、GITEA_DB_PASSWORD 均在 .env 中配置

# 访问端口号
GITEA_PORT=3000
# SSH端口号
GITEA_SSH_PORT=2220

# Gitea 数据持久化子目录名
# 完整路径 = ${DATA_PATH_HOST}/${GITEA_DATA_SUBDIR}（由 Compose 运行时拼装）
#   默认 → /data/volume_data/gitea
GITEA_DATA_SUBDIR=gitea

# ==========================================
# Rap2配置（API接口管理平台）
# ==========================================
# 前端访问端口
RAP2_FRONTEND_PORT=28081

# 数据库名称
RAP2_MYSQL_SCHEMA=RAP2_DELOS_APP
# 数据库账号凭证（敏感凭证统一放在根目录 .env，此处不再定义避免覆盖）
# RAP2_MYSQL_USER、RAP2_MYSQL_PASSWORD 均在 .env 中配置

# ==========================================
# 通用配置
# ==========================================
# 数据存储根路径
# 由 .env 统一维护（DATA_PATH_HOST=/data/volume_data），本文件不再重复定义
# 各服务子目录名（如 MYSQL_DATA_SUBDIR）拼装出完整路径，详见 compose YAML
