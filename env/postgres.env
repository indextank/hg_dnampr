# ==========================================
# postgres 配置（由原 database.env 拆分）
# ==========================================
# PostgreSQL 数据持久化子目录名
# 完整路径 = ${DATA_PATH_HOST}/${POSTGRES_DATA_SUBDIR}（由 Compose 运行时拼装）
#   默认 → /data/volume_data/postgres
# 整体迁移 → 仅修改 .env 中的 DATA_PATH_HOST 即可
# 如需整体替换完整路径，可在 .env 中显式覆盖 POSTGRES_DATA_PATH
POSTGRES_DATA_SUBDIR=postgres

# pgAdmin 数据持久化子目录名
# 完整路径 = ${DATA_PATH_HOST}/${PGADMIN_DATA_SUBDIR}（由 Compose 运行时拼装）
#   默认 → /data/volume_data/pgadmin
PGADMIN_DATA_SUBDIR=pgadmin

# PostgreSQL 主版本（构建目录与 Dockerfile 引用）
# 这是唯一需要配置的版本开关（如 19；回退 18 时改回 18 并确保 build/postgres/18/ 仍在）。
# 具体小版本由脚本自动解析 PGDG 通道最新 Candidate：
#   - 构建：derive_pg_build_ver → PG_VERSION（apt 完整版）/ PG_SOURCE_VERSION（上游如 19.0）
#   - 缓存：download_postgres_dependencies 下载 postgresql-<ver>.tar.gz 到 src/postgres/，
#           同主版本只保留一份
PG_MAJOR=19

# PostgreSQL 基础镜像变体（bookworm = Debian 12）
PG_VARIANT=bookworm

# 宿主机 → 容器 PostgreSQL 端口映射
PG_PORT=5432

# 超级用户账号凭证（敏感凭证统一放在根目录 .env，此处不再定义避免覆盖）
# PG_USER、PG_PASSWORD 均在 .env 中配置

# ------------------------------------------
# 基础资源限制（开发环境沿用此处的 limit + reservation）
# 由 compose/stacks/databases.yaml 直接引用，prod.yaml 覆盖
# ------------------------------------------

# PostgreSQL CPU 上限（开发环境默认：4 核）
PG_LIMITS_CPU=4

# PostgreSQL 内存上限（开发环境默认：16G）
# 推荐：shared_buffers = memory × 0.25，effective_cache_size = memory × 0.75
PG_LIMITS_MEMORY=4G

# PostgreSQL 内存预留（开发环境默认：4G）
PG_RESERVATIONS_MEMORY=4G

# pgAdmin Web 管理界面端口（宿主机 → 容器 80）
PGADMIN_PORT=65050

# pgAdmin 登录凭证（敏感凭证统一放在根目录 .env，此处不再定义避免覆盖）
# PGADMIN_DEFAULT_EMAIL、PGADMIN_DEFAULT_PASSWORD 均在 .env 中配置


# ==========================================
# 生产环境资源配置（默认 8 核 32G 系统）
# ==========================================
# 8 核 32G 单机部署时，PostgreSQL 与 MongoDB 共享剩余资源；
# MySQL 占核心位置（约一半资源），其余服务均按比例分配。
# 如部署于更高配置服务器，请按比例上调。
# ------------------------------------------

# ------------------------------- #
# PostgreSQL 服务
# ------------------------------- #

# 生产环境 PostgreSQL 副本数
# 固定 container_name + 宿主机 PG_PORT 时须保持为 1
# 多副本需配合 Patroni / pg_auto_failover 等方案
POSTGRES_PROD_REPLICAS=1

# 生产环境 PostgreSQL CPU 上限（8 核 × 25%）
POSTGRES_PROD_LIMITS_CPU=2

# 生产环境 PostgreSQL 内存上限（32G × 12.5% = 4G）
# 推荐参数：shared_buffers ≈ 1G，work_mem 按连接数计算，effective_cache_size ≈ 3G
POSTGRES_PROD_LIMITS_MEMORY=4G

# 生产环境 PostgreSQL CPU 预留（limit 的 50%）
POSTGRES_PROD_RESERVATIONS_CPU=1

# 生产环境 PostgreSQL 内存预留
POSTGRES_PROD_RESERVATIONS_MEMORY=2G

# ------------------------------- #
# pgAdmin 服务
# ------------------------------- #

# 生产环境 pgAdmin CPU 上限（管理界面，轻负载）
PGADMIN_PROD_LIMITS_CPU=0.5

# 生产环境 pgAdmin 内存上限
PGADMIN_PROD_LIMITS_MEMORY=1G

# 生产环境 pgAdmin CPU 预留
PGADMIN_PROD_RESERVATIONS_CPU=0.1

# 生产环境 pgAdmin 内存预留
PGADMIN_PROD_RESERVATIONS_MEMORY=256M


# ==========================================
# 开发环境资源配置
# ==========================================
# 开发环境 limit 由上方 PG_LIMITS_* 提供，本节只覆盖 reservations。
# ------------------------------------------

# 开发环境 PostgreSQL CPU 预留
POSTGRES_DEV_RESERVATIONS_CPU=0.1

# 开发环境 PostgreSQL 内存预留
POSTGRES_DEV_RESERVATIONS_MEMORY=256M

# 开发环境 pgAdmin CPU 预留
PGADMIN_DEV_RESERVATIONS_CPU=0.1

# 开发环境 pgAdmin 内存预留
PGADMIN_DEV_RESERVATIONS_MEMORY=128M
