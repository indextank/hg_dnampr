# ==========================================
# pgvector 配置（PostgreSQL 向量扩展）
# ==========================================
# 自建镜像：基于 build/postgres/18/bookworm 的构建逻辑，apt 安装 postgresql-18-pgvector
# 与主 PostgreSQL 实例独立部署；通过端口隔离。

# pgvector 数据持久化子目录名
# 完整路径 = ${DATA_PATH_HOST}/${PGVECTOR_DATA_SUBDIR}（由 Compose 运行时拼装）
#   默认 → /data/volume_data/pgvector
PGVECTOR_DATA_SUBDIR=pgvector

# PostgreSQL 主版本（构建目录与 Dockerfile 引用，与主 PG 保持一致）
PGVECTOR_PG_MAJOR=18

# PostgreSQL 基础镜像变体（bookworm = Debian 12）
PGVECTOR_VARIANT=bookworm

# 注：pgvector 基于 hg_dnmpr_postgres:latest 扩展，PG 小版本跟随主 PG（PG_MAJOR），
# 无需单独钉选 PGVECTOR_PG_VERSION。

# 宿主机 → 容器 pgvector 端口映射（避开主 PG 5432 与 TimescaleDB 5433）
PGVECTOR_PORT=5434

# 初始化时创建的超级用户与密码（敏感凭证统一放在根目录 .env，此处不再定义避免覆盖）
# PGVECTOR_USER、PGVECTOR_PASSWORD 均在 .env 中配置

# ------------------------------------------
# 基础资源限制（开发环境沿用此处的 limit + reservation）
# 由 compose/stacks/databases.yaml 直接引用，prod.yaml 覆盖
# ------------------------------------------

# pgvector CPU 上限（开发环境默认：2 核）
PGVECTOR_LIMITS_CPU=2

# pgvector 内存上限（开发环境默认：4G）
# 向量检索（HNSW/IVFFlat）对 maintenance_work_mem 较敏感，建议预留充足内存
PGVECTOR_LIMITS_MEMORY=4G

# pgvector 内存预留（开发环境默认：1G）
PGVECTOR_RESERVATIONS_MEMORY=1G


# ==========================================
# 生产环境资源配置（默认 8 核 32G 系统）
# ==========================================

# 生产环境 pgvector 副本数
# 固定 container_name + 宿主机 PGVECTOR_PORT 时须保持为 1
PGVECTOR_PROD_REPLICAS=1

# 生产环境 pgvector CPU 上限
PGVECTOR_PROD_LIMITS_CPU=2

# 生产环境 pgvector 内存上限
PGVECTOR_PROD_LIMITS_MEMORY=4G

# 生产环境 pgvector CPU 预留
PGVECTOR_PROD_RESERVATIONS_CPU=1

# 生产环境 pgvector 内存预留
PGVECTOR_PROD_RESERVATIONS_MEMORY=1G


# ==========================================
# 开发环境资源配置
# ==========================================
# 开发环境 limit 由上方 PGVECTOR_LIMITS_* 提供，本节只覆盖 reservations。
# ------------------------------------------

# 开发环境 pgvector CPU 预留
PGVECTOR_DEV_RESERVATIONS_CPU=0.1

# 开发环境 pgvector 内存预留
PGVECTOR_DEV_RESERVATIONS_MEMORY=256M
