# ==========================================
# 数据库备份服务配置
# ==========================================
# 本文件集中管理所有数据库备份服务的配置项，包括：
#   - 备份保留策略
#   - 各备份服务的连接参数、备份目录、镜像
#   - 生产 / 开发环境的备份服务资源配额
#
# 引用方：compose/stacks/databases.yaml
# ==========================================

# ------------------------------------------
# 备份保留策略（三个备份服务共用）
# ------------------------------------------
# 超过此天数的备份文件将被自动清理
BACKUP_RETENTION_DAYS=3

# ==========================================
# 备份执行时间（24 小时制，HH:MM）
# 每种数据库可单独维护，便于错峰与调度
# ==========================================

# MySQL 备份时间（默认每天 02:00）
MYSQL_BACKUP_AT=02:00

# MongoDB 备份时间（默认每天 02:45）
MONGO_BACKUP_AT=02:45

# PostgreSQL 备份时间（默认每天 04:20）
PG_BACKUP_AT=04:20

# TimescaleDB 备份时间（默认每天 04:40，与主 PG 错峰）
TIMESCALE_BACKUP_AT=04:40

# pgvector 备份时间（默认每天 05:00，与主 PG/TimescaleDB 错峰）
PGVECTOR_BACKUP_AT=05:00

# ClickHouse 备份时间（默认每天 05:20，与 PG 系列错峰）
CLICKHOUSE_BACKUP_AT=05:20




# ==========================================
# MySQL 备份服务
# ==========================================

# 备份文件存放目录（Bind Mount 到宿主机）
# 留空则回退到 compose 中定义的默认路径 /data/db_backup
MYSQL_BACKUP_DIR=/data/db_backup/mysql_backup

# 备份容器通过 Docker 内网连接的 MySQL 服务地址
# 默认值 mysql = compose 中 mysql-server 的 container_name / network alias
# 若修改了 MySQL 服务名或使用外部 MySQL，在此修改
MYSQL_BACKUP_HOST=mysql
# 注意：备份容器通过 Docker 内网连接 mysql 服务，应填写容器端口 3306；
# 不能填写宿主机映射端口（如 30306），否则会在容器内连接失败。
MYSQL_BACKUP_PORT=3306
MYSQL_BACKUP_USER=root

# 备份服务使用的镜像（与 mysql-server 共用同一镜像，随 mysql build 自动更新）
# 注意：mysql_backup 无独立 Dockerfile，直接复用 hg_dnmpr_mysql 镜像，
# 由 backup-mysql.sh 作为入口脚本覆盖默认 mysqld 命令。
MYSQL_BACKUP_IMAGE=hg_dnmpr_mysql:latest




# ==========================================
# MongoDB 备份服务
# ==========================================

# 备份文件存放目录（Bind Mount 到宿主机）
MONGO_BACKUP_DIR=/data/db_backup/mongo_backup

# 备份容器通过 Docker 内网连接的 MongoDB 服务地址
# 默认值 mongo = compose 中 mongo-server 的 container_name / network alias
MONGO_BACKUP_HOST=mongo
MONGO_BACKUP_PORT=60017

# 备份服务使用的镜像
MONGO_BACKUP_IMAGE=hg_dnmpr_mongo_backup:latest




# ==========================================
# PostgreSQL 备份服务
# ==========================================

# 备份文件存放目录（Bind Mount 到宿主机）
PG_BACKUP_DIR=/data/db_backup/pg_backup

# 备份容器通过 Docker 内网连接的 PostgreSQL 服务地址
# 默认值 postgres = compose 中 postgres-server 的 container_name / network alias
PG_BACKUP_HOST=postgres
PG_BACKUP_PORT=54032

# 备份服务使用的镜像
PG_BACKUP_IMAGE=hg_dnmpr_postgres_backup:latest




# ==========================================
# TimescaleDB 备份服务
# ==========================================

# 备份文件存放目录（Bind Mount 到宿主机）
TIMESCALE_BACKUP_DIR=/data/db_backup/timescaledb_backup

# 备份容器通过 Docker 内网连接的 TimescaleDB 服务地址
# 默认值 timescaledb = compose 中 timescaledb-server 的 container_name / network alias
TIMESCALE_BACKUP_HOST=timescaledb
TIMESCALE_BACKUP_PORT=5432

# 备份服务使用的镜像（复用 timescale/timescaledb:pg18 官方镜像，自带 pg_dump）
TIMESCALE_BACKUP_IMAGE=timescale/timescaledb:pg18




# ==========================================
# pgvector 备份服务
# ==========================================

# 备份文件存放目录（Bind Mount 到宿主机）
PGVECTOR_BACKUP_DIR=/data/db_backup/pgvector_backup

# 备份容器通过 Docker 内网连接的 pgvector 服务地址
PGVECTOR_BACKUP_HOST=pgvector
PGVECTOR_BACKUP_PORT=5432

# 备份服务使用的镜像（与 pgvector-server 共用同一镜像，随 pgvector build 自动更新）
PGVECTOR_BACKUP_IMAGE=hg_dnmpr_pgvector:latest




# ==========================================
# ClickHouse 备份服务
# ==========================================

# 备份文件存放目录（Bind Mount 到宿主机）
CLICKHOUSE_BACKUP_DIR=/data/db_backup/clickhouse_backup

# 备份容器通过 Docker 内网连接的 ClickHouse 服务地址
CLICKHOUSE_BACKUP_HOST=clickhouse
CLICKHOUSE_BACKUP_HTTP_PORT=8123

# 备份服务使用的镜像（复用自建 clickhouse 镜像，自带 clickhouse-client）
CLICKHOUSE_BACKUP_IMAGE=hg_dnmpr_clickhouse:latest




# ==========================================
# 生产环境 - 备份服务资源配额
# ==========================================

# MySQL 备份服务（生产）
MYSQL_BACKUP_PROD_LIMITS_CPU=4
MYSQL_BACKUP_PROD_LIMITS_MEMORY=8G
MYSQL_BACKUP_PROD_RESERVATIONS_CPU=2
MYSQL_BACKUP_PROD_RESERVATIONS_MEMORY=4G

# ==========================================
# 开发环境 - 备份服务资源配额
# ==========================================

# MySQL 备份服务（开发）
MYSQL_BACKUP_DEV_RESERVATIONS_CPU=0.1
MYSQL_BACKUP_DEV_RESERVATIONS_MEMORY=256M
