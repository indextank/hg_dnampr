# ==========================================
# mongodb 配置（由原 database.env 拆分）
# ==========================================
# MongoDB 数据持久化子目录名
# 完整路径 = ${DATA_PATH_HOST}/${MONGO_DATA_SUBDIR}（由 Compose 运行时拼装）
#   默认 → /data/volume_data/mongo
# 整体迁移 → 仅修改 .env 中的 DATA_PATH_HOST 即可
# 如需整体替换完整路径，可在 .env 中显式覆盖 MONGO_DATA_PATH
MONGO_DATA_SUBDIR=mongo

# Mongo 构建目录主版本（对应 build/mongo/<MONGO_BUILD_VERSION>/，仅主.次）
# 这是唯一需要配置的版本开关（如 8.0 / 8.2）。
# 具体小版本由脚本自动解析官方 apt 通道最新 Candidate：
#   - 构建：derive_mongo_build_ver → MONGO_VERSION
#   - 缓存：download_mongo_dependencies 下载 mongo-<ver>.tar.gz 到 src/mongo/，
#           同系列只保留一份
MONGO_BUILD_VERSION=8.2

# 宿主机 → 容器 MongoDB 端口映射
MONGO_HOST_PORT=60017

# MongoDB root 账号凭证（敏感凭证统一放在根目录 .env，此处不再定义避免覆盖）
# MONGO_INITDB_ROOT_USERNAME、MONGO_INITDB_ROOT_PASSWORD 均在 .env 中配置

# ------------------------------------------
# 基础资源限制（开发环境沿用此处的 limit + reservation）
# 由 compose/stacks/databases.yaml 直接引用，prod.yaml 覆盖
# ------------------------------------------

# MongoDB CPU 上限（开发环境默认：4 核）
MONGO_LIMITS_CPU=4

# MongoDB 内存上限（开发环境默认：6G）
# WiredTiger 引擎默认会使用 50% 内存作为 cache，超出限制将被 OOM Kill
MONGO_LIMITS_MEMORY=6G

# MongoDB 内存预留（开发环境默认：2G）
MONGO_RESERVATIONS_MEMORY=2G

# Mongo Express Web 管理界面端口（宿主机 → 容器 8081）
MONGO_EXPRESS_HOST_PORT=8081

# Mongo Express 账号凭证（敏感凭证统一放在根目录 .env，此处不再定义避免覆盖）
# ME_CONFIG_BASICAUTH_USERNAME、ME_CONFIG_BASICAUTH_PASSWORD
# ME_CONFIG_MONGODB_ADMINUSERNAME、ME_CONFIG_MONGODB_ADMINPASSWORD 均在 .env 中配置


# ==========================================
# 生产环境资源配置（默认 8 核 32G 系统）
# ==========================================
# 8 核 32G 单机部署时，MongoDB 作为文档型数据库占约 1/4 资源；
# MySQL 占核心位置，Mongo 与 Postgres 共享剩余 CPU 与内存。
# 如部署于更高配置服务器，请按比例上调。
# ------------------------------------------

# 生产环境 MongoDB 副本数
# 固定 container_name + 宿主机 MONGO_HOST_PORT 时须保持为 1
# 多副本需通过 MongoDB 副本集自身机制（rs.initiate）管理
MONGO_PROD_REPLICAS=1

# 生产环境 MongoDB CPU 上限（8 核 × 25%）
MONGO_PROD_LIMITS_CPU=2

# 生产环境 MongoDB 内存上限（32G × 12.5% = 4G）
# 推荐：WiredTiger cache = limit × 0.5（约 2G），剩余供连接/排序/聚合使用
MONGO_PROD_LIMITS_MEMORY=4G

# 生产环境 MongoDB CPU 预留（limit 的 50%）
MONGO_PROD_RESERVATIONS_CPU=1

# 生产环境 MongoDB 内存预留（满足常态 cache + 后台任务）
MONGO_PROD_RESERVATIONS_MEMORY=2G


# ==========================================
# 开发环境资源配置
# ==========================================
# 开发环境 limit 由上方 MONGO_LIMITS_* 提供，本节只覆盖 reservations。
# ------------------------------------------

# 开发环境 MongoDB CPU 预留
MONGO_DEV_RESERVATIONS_CPU=0.1

# 开发环境 MongoDB 内存预留
MONGO_DEV_RESERVATIONS_MEMORY=256M
