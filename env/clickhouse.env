# ==========================================
# ClickHouse 配置（OLAP 列式数据库）
# ==========================================
# 自建镜像：基于官方 clickhouse/clickhouse-server，预置中国镜像源回退、时区、自定义配置
# 默认开启原生 Prometheus metrics 端点（9362），由监控栈采集。

# ClickHouse 数据持久化子目录名
# 完整路径 = ${DATA_PATH_HOST}/${CLICKHOUSE_DATA_SUBDIR}（由 Compose 运行时拼装）
#   默认 → /data/volume_data/clickhouse
CLICKHOUSE_DATA_SUBDIR=clickhouse

# 官方基础镜像 tag（自建 Dockerfile 的 FROM）
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:24.8

# ClickHouse 主版本（构建目录主版本，对应 build/clickhouse/<CLICKHOUSE_BUILD_VERSION>/）
CLICKHOUSE_BUILD_VERSION=24.8

# 宿主机 → 容器 ClickHouse 端口映射
# 8123 = HTTP 接口；9000 = 原生 TCP 接口；9009 = 集群间副本/分布式通信
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_TCP_PORT=9000
CLICKHOUSE_INTERSERVER_PORT=9009

# 默认管理员用户名（由 users.xml 注入 default profile；凭证统一放在根目录 .env 可覆盖）
CLICKHOUSE_USER=clickhouse

# 管理员密码（敏感凭证统一放在根目录 .env，此处不再定义避免覆盖）
# CLICKHOUSE_PASSWORD 在 .env 中配置

# ClickHouse 数据存储路径（容器内，对应挂载卷根）
CLICKHOUSE_DATA_PATH=/var/lib/clickhouse

# ClickHouse 日志路径（容器内，对应挂载卷）
CLICKHOUSE_LOG_PATH=/var/log/clickhouse-server

# ------------------------------------------
# 基础资源限制（开发环境沿用此处的 limit + reservation）
# 由 compose/stacks/databases.yaml 直接引用，prod.yaml 覆盖
# ------------------------------------------

# ClickHouse CPU 上限（开发环境默认：2 核）
CLICKHOUSE_LIMITS_CPU=2

# ClickHouse 内存上限（开发环境默认：4G）
# OLAP 查询内存消耗大，建议按并发查询数与 max_memory_usage 联合调整
CLICKHOUSE_LIMITS_MEMORY=4G

# ClickHouse 内存预留（开发环境默认：1G）
CLICKHOUSE_RESERVATIONS_MEMORY=1G


# ==========================================
# 生产环境资源配置（默认 8 核 32G 系统）
# ==========================================

# 生产环境 ClickHouse 副本数
# 固定 container_name + 宿主机端口时须保持为 1
CLICKHOUSE_PROD_REPLICAS=1

# 生产环境 ClickHouse CPU 上限
CLICKHOUSE_PROD_LIMITS_CPU=2

# 生产环境 ClickHouse 内存上限
CLICKHOUSE_PROD_LIMITS_MEMORY=4G

# 生产环境 ClickHouse CPU 预留
CLICKHOUSE_PROD_RESERVATIONS_CPU=1

# 生产环境 ClickHouse 内存预留
CLICKHOUSE_PROD_RESERVATIONS_MEMORY=1G


# ==========================================
# 开发环境资源配置
# ==========================================
# 开发环境 limit 由上方 CLICKHOUSE_LIMITS_* 提供，本节只覆盖 reservations。
# ------------------------------------------

# 开发环境 ClickHouse CPU 预留
CLICKHOUSE_DEV_RESERVATIONS_CPU=0.1

# 开发环境 ClickHouse 内存预留
CLICKHOUSE_DEV_RESERVATIONS_MEMORY=256M
