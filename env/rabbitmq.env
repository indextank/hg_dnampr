# ==========================================
# RabbitMQ 消息队列配置
# ==========================================

# RabbitMQ版本配置（Alpine 镜像）
# https://hub.docker.com/_/rabbitmq
# 官方参考: https://github.com/docker-library/rabbitmq/tree/master/4.2/alpine
RABBITMQ_VERSION=4.2.5
# RabbitMQ 构建目录主版本（对应 build/rabbitmq/<RABBITMQ_BUILD_VERSION>/，仅主.次）
RABBITMQ_BUILD_VERSION=4.2

# RabbitMQ数据持久化路径
# 留空 → 使用 Docker Named Volume（自动管理，容器重建后保留）
# 填写宿主机绝对路径 → 使用 Bind Mount（路径透明，便于备份）
RABBITMQ_DATA_PATH=

# RabbitMQ日志目录
RABBITMQ_LOG_DIR=../../logs/rabbitmq

# RabbitMQ端口配置
# AMQP协议端口
RABBITMQ_HOST_PORT=56072
# Management Web UI 端口
RABBITMQ_MANAGEMENT_PORT=51672
# Erlang 分布式节点通信端口
RABBITMQ_DIST_PORT=52672

# RabbitMQ认证配置（敏感凭证统一放在根目录 .env，此处不再定义避免覆盖）
# RABBITMQ_DEFAULT_USER、RABBITMQ_DEFAULT_PASS、RABBITMQ_DEFAULT_VHOST 均在 .env 中配置

# Erlang Cookie（集群通信密钥，单节点也需要，统一放在根目录 .env，此处不再定义避免覆盖）
# RABBITMQ_ERLANG_COOKIE 在 .env 中配置

# RabbitMQ资源限制配置
RABBITMQ_LIMITS_CPU=2
RABBITMQ_LIMITS_MEMORY=2G
RABBITMQ_RESERVATIONS_MEMORY=512M
