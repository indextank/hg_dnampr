# ========================================
# Syncer (go_mysql_sync_es) 项目环境变量
# ========================================
# 用于 compose/stacks/syncer.yaml 编排文件
#
# 连接配置统一在 go_mysql_sync_es/configs/config.yaml。
# Docker 编排见 compose/stacks/syncer.yaml 中的 SYNCER_MYSQL_HOST / SYNCER_ELASTICSEARCH_ADDRESSES /
# SYNCER_MQ_RABBITMQ_URL；本机直跑 syncer 可不设这些变量（使用 YAML 中的 127.0.0.1）。

# ---------- 项目路径 ----------
# go_mysql_sync_es 项目相对于 hg_dnmpr 的路径
SYNCER_PROJECT_PATH=/data/go_mysql_sync_es

# ---------- Syncer 应用 ----------
SYNCER_HOST_PORT=8080
SYNCER_LIMITS_CPU=4
SYNCER_LIMITS_MEMORY=1G
SYNCER_RESERVATIONS_MEMORY=128M

# ---------- Elasticsearch 协议 ----------
# 控制 syncer 连接 ES 时使用的协议：http（dev）或 https（prod）。
# dev 环境：此处保持 http，与 elk.dev.env 的 ELK_HTTP_SSL_ENABLED=false 对应。
# prod 环境：由 elk.prod.env 中的 ELASTICSEARCH_PROTOCOL=https 覆盖此值。
# 注意：切换 prod 环境时无需修改本文件，./up.sh elk prod + syncer 会自动传入正确协议。
ELASTICSEARCH_PROTOCOL=https
