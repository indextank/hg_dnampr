# ==========================================
# 基础配置
# ==========================================
# 项目环境标识，选项：development或dev，production或prod
# build.sh / up.sh / ELK环境配置 / monitoring端口绑定均统一读取此项。
# 注意：本行为默认值；若根目录 .env 中定义了 ENVIRONMENT，则以 .env 为准（up.sh 明确支持覆盖）。
ENVIRONMENT=dev

# 项目版本号
VERSION=1.0.1.20261103

# 时区配置
TZ=Asia/Shanghai

# 预留字段
Z=

# ==========================================
# 网络和DNS配置
# ==========================================
# DNS服务器配置
DNS_PRIMARY=223.5.5.5
DNS_SECONDARY=119.29.29.29

# ==========================================
# 源码镜像配置
# ==========================================
# 使用国内镜像源加速
CHANGE_SOURCE=true

# Alpine Linux镜像源
ALPINE_REPOSITORIES=mirrors.ustc.edu.cn

# ==========================================
# Monitoring 告警阈值
# ==========================================
# 队列中待处理（ready）消息数的阈值，即如果 RabbitMQ 某个队列的 ready 消息数持续超过 1000，就会触发队列堆积告警。
MONITORING_RABBITMQ_READY_THRESHOLD=100

# 队列中未被消费端确认（unacked）消息数的阈值，即如果 RabbitMQ 某个队列的 unacked 消息数持续超过 500，就会触发消费确认告警。
MONITORING_RABBITMQ_UNACKED_THRESHOLD=100

# Syncer 消费/同步延迟的阈值（单位：毫秒），当落后超过 1000ms 时会告警。
MONITORING_SYNC_LAG_THRESHOLD=1000
# ACK 超时日志匹配窗口
MONITORING_ACK_TIMEOUT_WINDOW=5m

# ==========================================
# 日志配置优化
# ==========================================
# 单个日志文件最大大小
LOG_MAX_SIZE=50m

# 保留的日志文件数量
LOG_MAX_FILE=5

# ==========================================
# ELK 默认安全配置（开发环境）
# ==========================================
# 默认启用安全功能但不启用SSL（开发环境）
# Kibana需要基本的安全API才能正常工作
# 生产环境会通过elk.prod.env覆盖并启用SSL
ELK_SECURITY_ENABLED=true
ELK_TRANSPORT_SSL_ENABLED=false
ELK_HTTP_SSL_ENABLED=false
