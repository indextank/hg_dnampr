# ==========================================
# Redis服务配置
# ==========================================
# Redis 构建目录主版本（对应 build/redis/<REDIS_BUILD_VERSION>/，仅主.次）
# 唯一版本开关：具体小版本由 derive_redis_build_ver 自动解析（GitHub tags / download.redis.io），
# 并缓存 redis-<ver>.tar.gz 到 src/redis/（同系列只保留一份）
# 可选：7.2 / 8.2 / 8.4 / 8.6 / 8.8 / 8.10
REDIS_BUILD_VERSION=8.10

# Valkey 构建目录主版本（对应 build/valkey/<VALKEY_BUILD_VERSION>/，仅主.次）
# https://hub.docker.com/r/valkey/valkey （官方推荐 alpine3.24）
# 唯一版本开关：derive_valkey_build_ver 自动解析；缓存到 src/valkey/
# 可选 8.1 / 9.0 / 9.1；compose/脚本兜底值须与此处保持一致
# 注意：升级主版本前请先备份 valkey 数据卷（RDB/AOF 不保证可回退到旧版本）
VALKEY_BUILD_VERSION=8.1

# Redis端口
REDIS_HOST_PORT=63079

# Redis/Valkey 宿主机端口绑定地址（容器间访问走 docker backend 网络，不受影响）
#   127.0.0.1 = 仅本机访问（默认）
#   0.0.0.0   = 对外开放（需配合防火墙/安全组限制来源）
# 容器内 redis.conf：bind 0.0.0.0 + protected-mode yes（口令由 --requirepass 注入；
# 勿把 bind 改成 127.0.0.1，否则 PHP/监控等容器无法连接）
REDIS_BIND_HOST=127.0.0.1

# Redis配置文件路径（默认留空：由 derive_redis_conf_paths 按 REDIS_BUILD_VERSION 自动派生）
# REDIS_CONF_FILE=

# Redis日志目录
REDIS_LOG_DIR=../../logs/redis

# Redis 数据持久化目录
# 留空 → 使用 Docker Named Volume（redis_data）
# 填写宿主机绝对路径 → 使用 Bind Mount，如 /data/redis
# 注意：build/redis/${REDIS_BUILD_VERSION:-8.10}/redis.conf 中 dir 已设为 /data，容器内数据写入此路径
REDIS_DATA_DIR=

# Valkey 数据持久化目录（与 Redis 同理）
VALKEY_DATA_DIR=

# 访问口令：在根目录 .env 中配置 REDIS_PASSWORD（redis/valkey 共用，勿写入本文件或 redis.conf）
# 容器默认由官方入口脚本降权为 redis/valkey 用户运行，首次启动会把 /data 属主修正为该用户。
# 应急回退（仅 redis，恢复 root 运行）：取消下行注释；排查完成后请恢复注释
# SKIP_DROP_PRIVS=1

# Redis CPU限制
REDIS_LIMITS_CPU=2

# Redis内存限制
REDIS_LIMITS_MEMORY=4G

# Redis内存预留
REDIS_RESERVATIONS_MEMORY=1G

# ==========================================
# 生产环境资源配置
# ==========================================

# 生产环境Redis副本数（固定 container_name + 宿主机 REDIS_HOST_PORT 时须为 1）
REDIS_PROD_REPLICAS=1

# 生产环境Redis CPU限制
REDIS_PROD_LIMITS_CPU=0.5

# 生产环境Redis内存限制
REDIS_PROD_LIMITS_MEMORY=512M

# 生产环境Redis CPU预留
REDIS_PROD_RESERVATIONS_CPU=0.25

# 生产环境Redis内存预留
REDIS_PROD_RESERVATIONS_MEMORY=256M

# ------------------------------- #

# 生产环境Valkey副本数（固定 container_name + 宿主机端口时须为 1）
VALKEY_PROD_REPLICAS=1

# 生产环境Valkey CPU限制
VALKEY_PROD_LIMITS_CPU=2

# 生产环境Valkey内存限制（须大于数据集加载峰值与 redis.conf maxmemory）
VALKEY_PROD_LIMITS_MEMORY=6G

# 生产环境Valkey CPU预留
VALKEY_PROD_RESERVATIONS_CPU=1

# 生产环境Valkey内存预留
VALKEY_PROD_RESERVATIONS_MEMORY=2G

# ==========================================
# 开发环境资源配置
# ==========================================

# 开发环境Redis CPU预留
REDIS_DEV_RESERVATIONS_CPU=0.1

# 开发环境Redis内存预留
REDIS_DEV_RESERVATIONS_MEMORY=128M

# 开发环境Valkey CPU预留
VALKEY_DEV_RESERVATIONS_CPU=0.1

# 开发环境Valkey内存预留
VALKEY_DEV_RESERVATIONS_MEMORY=128M
