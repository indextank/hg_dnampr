# ==========================================
# Canal Server（MySQL binlog → RabbitMQ）
# ==========================================
# 参考: https://github.com/alibaba/canal/tree/master/docker
# 与 compose/stacks/rabbitmq.yaml 中的 canal-server 服务配合使用。
#
# 前置条件：
#   1. MySQL 已开启 binlog（本仓库 mysql-dev.cnf / mysql-prod.cnf 已配置 log_bin）
#   2. 在 MySQL 中创建复制账号（示例，密码请与下方 CANAL_INSTANCE_DB_PASSWORD 一致）：
#        CREATE USER IF NOT EXISTS 'canal'@'%' IDENTIFIED BY 'canal';
#        GRANT SELECT, REPLICATION SLAVE, REPLICATION CLIENT ON *.* TO 'canal'@'%';
#        FLUSH PRIVILEGES;
#   3. rabbitmq.env 中的账号/密码需与 build/canal/config/canal.properties 中 rabbitmq.* 保持一致
#
# 运行身份：官方通过 su/runuser 降为 admin，在 Docker Desktop/WSL 下易 EAGAIN；
# 本仓库 build/canal/app.sh 改为 root 直接启动进程，生产请自行评估隔离与权限。

# 官方基础镜像版本（由 build/canal/Dockerfile 的 ARG 使用）
CANAL_VERSION=v1.1.8

# Canal Server 父目录名（配置/日志共用）
# 完整路径：
#   CANAL_CONFIG_PATH = ${DATA_PATH_HOST}/${CANAL_DATA_SUBDIR}/conf
#   CANAL_LOG_PATH    = ${DATA_PATH_HOST}/${CANAL_DATA_SUBDIR}/logs
#   默认 → /data/volume_data/canal-server/conf 与 /data/volume_data/canal-server/logs
# 整体迁移 → 仅修改 .env 中的 DATA_PATH_HOST 即可
# 如需覆盖完整路径，可在 .env 中显式赋值 CANAL_CONFIG_PATH / CANAL_LOG_PATH
CANAL_DATA_SUBDIR=canal-server

# 宿主机映射端口（admin / tcp / metrics）
CANAL_ADMIN_PORT=11110
CANAL_SERVER_PORT=11111
CANAL_METRICS_PORT=11112

# Canal MQ 配置（RabbitMQ 模式）
# canal.mq.servers: RabbitMQ 服务器地址（compose 网络内使用服务名）
# canal.mq.canalBatchSize: 每批从内存队列取出并构建 MQ 消息的最大条数（默认 50）
# canal.mq.canalGetTimeout: 从内存队列拉取时的等待超时毫秒数（默认 100）
# 注意：canal.mq.batchSize 仅适用于 Kafka 模式，RabbitMQ 模式无效
CANAL_MQ_SERVERS=rabbitmq
CANAL_MQ_CANAL_BATCH_SIZE=50
CANAL_MQ_CANAL_GET_TIMEOUT=100

# Canal Admin 认证（敏感凭证统一放在根目录 .env，此处不再定义避免覆盖）
# CANAL_ADMIN_USER、CANAL_ADMIN_PASSWORD 均在 .env 中配置

# Canal 连接的 MySQL（生产环境 beacon 库在远端服务器）
CANAL_MYSQL_HOST=172.26.219.242
CANAL_MYSQL_PORT=3306

# 与 build/canal/config/example/instance.properties 中 canal.instance.db* 对齐
# 默认账号名如下（凭证统一放在根目录 .env，可覆盖）；密码在 .env 中配置
CANAL_INSTANCE_DB_USERNAME=canal

# 资源限制（Docker Compose deploy）
CANAL_LIMITS_CPU=4
CANAL_LIMITS_MEMORY=2G
CANAL_RESERVATIONS_MEMORY=512M
