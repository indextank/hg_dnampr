# ==========================================
# PHP版本配置
# ==========================================
# PHP版本 - 仅支持格式：tar.xz

# PHP 8.5 最新版本
PHP85_VERSION=8.5.12
# PHP 8.4 最新版本
PHP84_VERSION=8.4.27
# PHP 8.3 稳定版本
PHP83_VERSION=8.3.36
# PHP 8.2 稳定版本
PHP82_VERSION=8.2.35
# PHP 8.1 稳定版本
PHP81_VERSION=8.1.33
# PHP 8.0 稳定版本
PHP80_VERSION=8.0.30
# PHP 7.4 稳定版本
PHP74_VERSION=7.4.33

# ==========================================
# Node.js（可选，镜像构建阶段）
# ==========================================
# 是否在构建 PHP 镜像时执行 nvm 并安装 Node（true=安装，其它=跳过）
PHP_IMAGE_INSTALL_NVM=false
# 构建时安装的 Node 版本（仅当 PHP_IMAGE_INSTALL_NVM=true）
PHP_IMAGE_NODE_VERSION=26.1.0
# nvm 下载 Node 预编译包使用的镜像（与 https://nodejs.org/dist/ 布局一致）
# 参考：https://mirrors.tuna.tsinghua.edu.cn/help/nodejs-release/
PHP_IMAGE_NVM_NODE_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/nodejs-release/

# ==========================================
# PHP通用扩展配置
# ==========================================
# 扩展列表 - 按需启用，避免安装不必要的扩展：含grpc、protobuf、imagick
PHP_COMMON_EXTENSIONS=redis,mongodb,swoole,yaml,imagick

# 完整扩展列表（注释掉，按需启用）
# PHP_COMMON_EXTENSIONS=bcmath,bz2,calendar,Core,ctype,curl,date,dom,exif,fileinfo,filter,ftp,gd,gettext,hash,iconv,json,libxml,mbstring,mcrypt,mysqli,mysqlnd,openssl,pcre,PDO,pdo_mysql,pdo_sqlite,Phar,posix,readline,Reflection,session,SimpleXML,soap,sockets,sodium,SPL,sqlite3,standard,tokenizer,xml,xmlreader,xmlwriter,zip,zlib,swoole,redis,imagick,mongodb,xdebug,grpc,protobuf,rdkafka,zookeeper,yaml

# ==========================================
# 扩展版本配置
# ==========================================
# 支持PHP8+, 8.0以下版本会自动匹配安装旧版本;  v3.2.2只支持 8.0-8.2版本
# Xdebug扩展版本
XDEBUG_EXT_VERSION=3.5.3
# Swoole扩展版本（php>8.0）
# PECL stable 6.2.2，支持 PHP 8.2-8.5（依赖声明：PHP >=8.2.0 且 <=8.5.99）
# 6.2.0 起移除了 --enable-openssl 选项（OpenSSL 默认内置），PHP 8.1 不再受支持
SWOOLE_EXT_VERSION=6.2.3
SWOOLE60_EXT_VERSION=6.0.2
# Swoole 7.x扩展版本
SWOOLE7_EXT_VERSION=5.1.3
# gRPC扩展版本
GRPC_EXT_VERSION=1.84.0
# Redis扩展版本
REDIS_EXT_VERSION=6.3.0
# MongoDB扩展版本（自动版本选择）
MONGODB_EXT_VERSION=2.5.5
# Imagick扩展版本
IMAGICK_EXT_VERSION=3.8.1
# YAML扩展版本
YAML_EXT_VERSION=2.3.0
# RdKafka扩展版本
RDKAFKA_EXT_VERSION=6.0.5
# ZooKeeper扩展版本
ZOOKEEPER_EXT_VERSION=1.3.0
# Protobuf扩展版本
PROTOBUF_EXT_VERSION=5.36.2
# Memcached扩展版本
MEMCACHED_VERSION=3.4.0

# ==========================================
# 系统库版本配置  https://openssl-library.org/source/
# ==========================================
# OpenSSL LTS版本，支持到2030年4月8日
OPENSSL_VERSION=3.5.9
# OpenSSL 1.1.1版本（兼容旧版本）
OPENSSL_VERSION_11=1.1.1w

# cURL最新稳定版本
# https://curl.se/download.html
CURL_VERSION=8.23.0

# FreeType字体渲染库版本
# https://download.savannah.gnu.org/releases/freetype/
FREETYPE_VERSION=2.15.0

# WebP图像格式支持库版本
# https://github.com/webmproject/libwebp/tags
LIBWEBP_VERSION=1.6.0

# 字符编码转换库版本
# https://ftp.gnu.org/pub/gnu/libiconv/
LIBICONV_VERSION=1.19

# Sodium加密库版本
# https://github.com/jedisct1/libsodium/releases/
LIBSODIUM_VERSION=1.0.22

# ImageMagick图像处理库版本 https://imagemagick.org/archive/
# https://download.imagemagick.org/archive/
IMAGICK_VERSION=7.1.2-34

# RdKafka消息队列库版本
LIBRDKAFKA_VERSION=2.16.0

# ZooKeeper分布式协调服务版本
# https://zookeeper.apache.org/releases
ZOOKEEPER_VERSION=3.8.7

# Protocol Buffers序列化库版本
# https://github.com/protocolbuffers/protobuf/releases
PROTOBUF_VERSION=36.2

# ==========================================
# PHP性能配置优化
# ==========================================
# 说明：以下变量（含 memory_limit、display_errors、error_reporting 等运行时项）
# 与下方「资源限制配置 (Docker)」采用同一套分层方式，由 ENVIRONMENT 自动分流：
#   - 开发环境取 PHP_DEV_*，生产环境取 PHP_PROD_*；
#   - up.sh 依据 env/base.env 的 ENVIRONMENT 选择对应值，写入
#     build/php/common/zz-profile-overrides.ini，并挂载到容器 conf.d 生效；
#   - compose/overlays/dev.yaml、prod.yaml 同时将其映射为容器内统一变量名
#     （PHP_MEMORY_LIMIT 等）供应用读取。

# 开发环境PHP内存限制
PHP_DEV_MEMORY_LIMIT=1024M
# 开发环境最大执行时间（秒）
PHP_DEV_MAX_EXECUTION_TIME=300
# 开发环境最大上传文件大小
PHP_DEV_UPLOAD_MAX_FILESIZE=128M
# 开发环境POST数据最大大小
PHP_DEV_POST_MAX_SIZE=128M
# 开发环境最大输入变量数量
PHP_DEV_MAX_INPUT_VARS=5000
# 开发环境是否显示错误（开发建议 On，便于调试）
PHP_DEV_DISPLAY_ERRORS=On
# 开发环境错误报告级别
PHP_DEV_ERROR_REPORTING=E_ALL

# 生产环境PHP内存限制
PHP_PROD_MEMORY_LIMIT=2048M
# 生产环境最大执行时间（秒）
PHP_PROD_MAX_EXECUTION_TIME=60
# 生产环境最大上传文件大小
PHP_PROD_UPLOAD_MAX_FILESIZE=128M
# 生产环境POST数据最大大小
PHP_PROD_POST_MAX_SIZE=128M
# 生产环境最大输入变量数量
PHP_PROD_MAX_INPUT_VARS=5000
# 生产环境是否显示错误（生产建议 Off，避免泄露敏感信息）
PHP_PROD_DISPLAY_ERRORS=Off
# 生产环境错误报告级别
PHP_PROD_ERROR_REPORTING="E_ALL & ~E_DEPRECATED"

# ==========================================
# 资源限制配置 (Docker)
# ==========================================
# 兜底默认：compose/stacks/php.yaml 在未设置环境专属值时使用
# 容器CPU限制
PHP_LIMITS_CPU=4
# 容器内存限制
PHP_LIMITS_MEMORY=2G
# 容器CPU预留
PHP_RESERVATIONS_CPU=1
# 容器内存预留
PHP_RESERVATIONS_MEMORY=1G

# 开发环境CPU限制
PHP_DEV_LIMITS_CPU=8
# 开发环境内存限制
PHP_DEV_LIMITS_MEMORY=8G
# 开发环境CPU预留
PHP_DEV_RESERVATIONS_CPU=0.5
# 开发环境内存预留
PHP_DEV_RESERVATIONS_MEMORY=512M

# 生产环境CPU限制
PHP_PROD_LIMITS_CPU=8
# 生产环境内存限制
PHP_PROD_LIMITS_MEMORY=32G
# 生产环境CPU预留
PHP_PROD_RESERVATIONS_CPU=2
# 生产环境内存预留
PHP_PROD_RESERVATIONS_MEMORY=2G

# 生产环境PHP容器副本数（各版本固定 container_name + 宿主机 PHPxx_PORT 时须为 1）
PHP_PROD_REPLICAS=1

# ==========================================
# PHP服务端口配置
# ==========================================
# 各PHP版本的端口配置（避免端口冲突）
# PHP 8.5 端口
PHP85_PORT=8085
# PHP 8.4 端口
PHP84_PORT=8084
# PHP 8.3 端口
PHP83_PORT=8083
# PHP 8.2 端口
PHP82_PORT=8082
# PHP 8.1 端口
PHP81_PORT=8081
# PHP 8.0 端口
PHP80_PORT=8080
# PHP 7.4 端口
PHP74_PORT=8074

# ==========================================
# PHP服务器名称配置
# ==========================================
# 虚拟主机配置，用于Apache/Nginx
PHP85_SERVER_NAME=php85.default.com
PHP84_SERVER_NAME=php84.default.com
PHP83_SERVER_NAME=php83.default.com
PHP82_SERVER_NAME=php82.default.com
PHP81_SERVER_NAME=php81.default.com
PHP80_SERVER_NAME=php80.default.com
PHP74_SERVER_NAME=php74.default.com

# ==========================================
# PHP配置文件路径
# ==========================================
# 各PHP版本的配置文件路径
PHP85_PHP_CONF_FILE=../../build/php/8.5/php.ini
PHP84_PHP_CONF_FILE=../../build/php/8.4/php.ini
PHP83_PHP_CONF_FILE=../../build/php/8.3/php.ini
PHP82_PHP_CONF_FILE=../../build/php/8.2/php.ini
PHP81_PHP_CONF_FILE=../../build/php/8.1/php.ini
PHP80_PHP_CONF_FILE=../../build/php/8.0/php.ini
PHP74_PHP_CONF_FILE=../../build/php/7.4/php.ini

# ==========================================
# 开发环境额外端口配置（仅 dev overlay 生效）
# ==========================================
# 说明：
#   以下端口仅在 ENVIRONMENT=development 时由 compose/overlays/dev.yaml 自动映射和路由。
#   生产环境（prod overlay）不包含这些映射，确保安全。
#   同时为每个端口配置 Traefik 路由标签，可通过域名访问（需 Traefik 已部署）。
#
#   扩展方式：
#   1. 在下方添加 PHPXX_<SERVICE>_PORT 和 PHPXX_<SERVICE>_SERVER_NAME 变量
#   2. 在 compose/overlays/dev.yaml 对应服务的 ports 和 labels 中引用

# PHP 8.4 Hyperf HTTP Server
PHP84_HYPERF_SERVER_NAME=php84-hyperf.default.com
