# ==========================================
# TimescaleDB 配置（PostgreSQL 时序扩展）
# ==========================================
# 采用官方 timescale/timescaledb:pg18 镜像（无 Dockerfile 构建）
# 与主 PostgreSQL 实例独立部署，避免扩展冲突；通过端口隔离。

# TimescaleDB 数据持久化子目录名
# 完整路径 = ${DATA_PATH_HOST}/${TIMESCALE_DATA_SUBDIR}（由 Compose 运行时拼装）
#   默认 → /data/volume_data/timescaledb
TIMESCALE_DATA_SUBDIR=timescaledb

# 官方镜像 tag（固定到 PG 主版本，由 Timescale 官方维护）
TIMESCALE_IMAGE=timescale/timescaledb:pg18

# 宿主机 → 容器 TimescaleDB 端口映射（避开主 PostgreSQL 的 5432）
TIMESCALE_PORT=5433

# 超级用户账号凭证（敏感凭证统一放在根目录 .env，此处不再定义避免覆盖）
# TIMESCALE_USER、TIMESCALE_PASSWORD 均在 .env 中配置

# 预加载库：TimescaleDB 必须在 shared_preload_libraries 中才能使用压缩/连续聚合等特性
TIMESCALE_SHARED_PRELOAD_LIBRARIES=timescaledb

# ------------------------------------------
# 基础资源限制（开发环境沿用此处的 limit + reservation）
# 由 compose/stacks/databases.yaml 直接引用，prod.yaml 覆盖
# ------------------------------------------

# TimescaleDB CPU 上限（开发环境默认：2 核）
TIMESCALE_LIMITS_CPU=2

# TimescaleDB 内存上限（开发环境默认：4G）
# 推荐：shared_buffers = memory × 0.25，timescaledb.max_background_workers 视压缩任务量调整
TIMESCALE_LIMITS_MEMORY=4G

# TimescaleDB 内存预留（开发环境默认：1G）
TIMESCALE_RESERVATIONS_MEMORY=1G


# ==========================================
# 生产环境资源配置（默认 8 核 32G 系统）
# ==========================================

# 生产环境 TimescaleDB 副本数
# 固定 container_name + 宿主机 TIMESCALE_PORT 时须保持为 1
# 多副本需配合 Patroni / pg_auto_failover 等方案
TIMESCALE_PROD_REPLICAS=1

# 生产环境 TimescaleDB CPU 上限
TIMESCALE_PROD_LIMITS_CPU=2

# 生产环境 TimescaleDB 内存上限
TIMESCALE_PROD_LIMITS_MEMORY=4G

# 生产环境 TimescaleDB CPU 预留
TIMESCALE_PROD_RESERVATIONS_CPU=1

# 生产环境 TimescaleDB 内存预留
TIMESCALE_PROD_RESERVATIONS_MEMORY=1G


# ==========================================
# 开发环境资源配置
# ==========================================
# 开发环境 limit 由上方 TIMESCALE_LIMITS_* 提供，本节只覆盖 reservations。
# ------------------------------------------

# 开发环境 TimescaleDB CPU 预留
TIMESCALE_DEV_RESERVATIONS_CPU=0.1

# 开发环境 TimescaleDB 内存预留
TIMESCALE_DEV_RESERVATIONS_MEMORY=256M
