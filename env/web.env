# ==========================================
# Web服务配置 (依赖服务)
# ==========================================
# Nginx稳定版本
NGINX_VERSION=1.30.7
# Nginx 构建目录主版本（对应 build/nginx/<NGINX_BUILD_VERSION>/，仅主.次）
NGINX_BUILD_VERSION=1.30

# Tengine版本配置（阿里巴巴开源的Nginx增强版）
TENGINE_VERSION=3.1.0
# Tengine 构建目录主版本（对应 build/tengine/<TENGINE_BUILD_VERSION>/，仅主.次）
TENGINE_BUILD_VERSION=3.1

# # Apache HTTP Server版本
# APACHE_VERSION=2.4.66
# # Apache Portable Runtime版本
# APR_VERSION=1.7.6
# # Apache Portable Runtime Utility版本
# APR_UTIL_VERSION=1.6.3

# Perl Compatible Regular Expressions版本
PCRE_VERSION=8.45

# Headers More Nginx Module版本
HEADERS_MORE_NGINX_MODULE_VERSION=0.38

# ==========================================
# Nginx 压缩模块配置
# ==========================================
# ngx_brotli 模块版本（Google Brotli 压缩 NGINX 模块）
NGX_BROTLI_VERSION=1.0.0rc
# zstd-nginx-module 版本（Cloudflare Zstandard 压缩 NGINX 模块）
NGX_ZSTD_VERSION=0.1.1
#
# 压缩模块启用开关（true/false）
# 控制 Dockerfile 构建时是否编译对应模块，同时也控制运行时压缩配置生成。
# 可选组合：仅 brotli / 仅 zstd / 两者都启用 / 两者都禁用（仅 gzip）
NGINX_ENABLE_BROTLI=true
NGINX_ENABLE_ZSTD=true

# ==========================================
# Web服务器端口配置
# ==========================================
# Nginx HTTP端口
NGINX_HTTP_HOST_PORT=80
# Nginx HTTPS端口
NGINX_HTTPS_HOST_PORT=443

# ==========================================
# 日志和配置目录
# ==========================================
# 本地项目根目录 - 根据自己需要修改
# 开发环境：/data/wwwroot 或 ./src
# 生产环境：/var/www/html 或 /app
GLOBAL_WEB_PATH=/data/wwwroot

# Nginx日志目录
NGINX_LOG_DIR=../../logs/nginx
# Apache日志目录
APACHE_LOG_DIR=../../logs/apache

# Nginx虚拟主机配置目录
NGINX_VHOST_DIR=../../vhost/nginx_vhost
# Apache虚拟主机配置目录
APACHE_VHOST_DIR=../../vhost/apache_vhost

# Nginx主配置文件
NGINX_CONF_FILE=../../build/nginx/1.30/config/nginx.conf
# mime.types（与主配置同目录；挂载覆盖镜像内文件，避免整目录 bind 覆盖后丢失）
NGINX_MIME_TYPES_FILE=../../build/nginx/1.30/config/mime.types
# Tengine主配置文件
TENGINE_CONF_FILE=../../build/tengine/3.1/config/nginx.conf

# ==========================================
# 资源限制配置
# ==========================================
# Nginx CPU限制
NGINX_LIMITS_CPU=0.5
# Nginx内存限制
NGINX_LIMITS_MEMORY=256M
# Nginx CPU预留
NGINX_RESERVATIONS_CPU=0.25
# Nginx内存预留
NGINX_RESERVATIONS_MEMORY=128M

# Tengine CPU限制
TENGINE_LIMITS_CPU=0.5
# Tengine内存限制
TENGINE_LIMITS_MEMORY=256M
# Tengine CPU预留
TENGINE_RESERVATIONS_CPU=0.25
# Tengine内存预留
TENGINE_RESERVATIONS_MEMORY=128M

# ==========================================
# 生产环境资源配置
# ==========================================
# 生产环境Nginx副本数（compose 中固定 container_name + 映射宿主机端口时须为 1，否则 compose 校验失败）
NGINX_PROD_REPLICAS=1
# 生产环境Nginx CPU限制
NGINX_PROD_LIMITS_CPU=1
# 生产环境Nginx内存限制
NGINX_PROD_LIMITS_MEMORY=512M
# 生产环境Nginx CPU预留
NGINX_PROD_RESERVATIONS_CPU=0.5
# 生产环境Nginx内存预留
NGINX_PROD_RESERVATIONS_MEMORY=256M

# 生产环境Tengine副本数（同上，须与 container_name/端口方案一致）
TENGINE_PROD_REPLICAS=1
# 生产环境Tengine CPU限制
TENGINE_PROD_LIMITS_CPU=1
# 生产环境Tengine内存限制
TENGINE_PROD_LIMITS_MEMORY=512M
# 生产环境Tengine CPU预留
TENGINE_PROD_RESERVATIONS_CPU=0.5
# 生产环境Tengine内存预留
TENGINE_PROD_RESERVATIONS_MEMORY=256M

# ==========================================
# 开发环境资源配置
# ==========================================
# 开发环境Nginx CPU预留
NGINX_DEV_RESERVATIONS_CPU=0.1
# 开发环境Nginx内存预留
NGINX_DEV_RESERVATIONS_MEMORY=64M

# 开发环境Tengine CPU预留
TENGINE_DEV_RESERVATIONS_CPU=0.1
# 开发环境Tengine内存预留
TENGINE_DEV_RESERVATIONS_MEMORY=64M
