# ==========================================
# mysql 配置（由原 database.env 拆分）
# ==========================================
# MySQL 数据持久化子目录名
# 完整路径 = ${DATA_PATH_HOST}/${MYSQL_DATA_SUBDIR}（由 Compose 运行时拼装）
#   默认 → /data/volume_data/mysql
# 整体迁移 → 仅修改 .env 中的 DATA_PATH_HOST 即可
# 如需整体替换完整路径，可在 .env 中显式覆盖 MYSQL_DATA_PATH
MYSQL_DATA_SUBDIR=mysql

# 初始化时默认创建的数据库
MYSQL_DATABASE=mysql

# 账号凭证（敏感凭证统一放在根目录 .env，此处不再定义避免覆盖）
# MYSQL_USER、MYSQL_PASSWORD、MYSQL_ROOT_PASSWORD 均在 .env 中配置
# MYSQL_USER：初始化时额外创建的普通用户（生产环境建议置空，仅使用 root 账号）
# MYSQL_ROOT_PASSWORD：root 密码（必填，请确保强度）

# 允许 root 远程登录的来源（% 表示任意来源）
MYSQL_ROOT_HOST=%

# MySQL 构建目录主版本（对应 build/mysql/<MYSQL_BUILD_VERSION>/，仅主.次）
# 这是唯一需要配置的版本开关：8.0 / 8.4 / 9.7。
# 具体小版本由脚本自动解析 repo.mysql.com 该通道最新 Candidate：
#   - 构建：derive_mysql_build_ver → MYSQL_VER → apt 安装
#   - 缓存：download_mysql_dependencies 下载 mysql-<ver>.tar.gz 到 src/mysql/，
#           同系列只保留一份（如 9.7.x 到位后自动删除旧补丁包）
# 参考：https://dev.mysql.com/downloads/mysql/ / https://hub.docker.com/_/mysql
# 注意：compose/脚本兜底值须与此处保持一致；8.4 → 9.7 为单向数据字典升级（不可回退），
#       切换前请先做逻辑备份并在副本上演练，且客户端须支持 caching_sha2_password。
MYSQL_BUILD_VERSION=8.4

# MySQL 主配置路径（容器内挂载为 /etc/mysql/my.cnf）
# 默认留空：由脚本层 derive_mysql_conf_paths / compose 嵌套默认值按 MYSQL_BUILD_VERSION 自动派生为
#   build/mysql/<MYSQL_BUILD_VERSION>/config/my.cnf
# 仅当需要指向非标准路径时才在此处（或 .env）显式赋值覆盖
# MYSQL_CONF_FILE=

# 环境特定 MySQL 配置（如 mysql-dev.cnf / mysql-prod.cnf）
# 容器内挂载为 /etc/mysql/conf.d/mysql-env.cnf
# 默认留空：自动派生为 build/mysql/<MYSQL_BUILD_VERSION>/config/conf.d/mysql-<dev|prod>.cnf
# （up.sh 会按当前环境自动切换 dev/prod 变体并校验文件存在性）
# 仅当需要指向非标准路径时才在此处（或 .env）显式赋值覆盖
# MYSQL_ENV_CONFIG_FILE=

# MySQL 基础镜像变体（bookworm = Debian 12）
MYSQL_VARIANT=bookworm

# gosu 版本（Docker entrypoint 用于降权运行）
GOSU_VERSION=1.19

# MySQL apt 仓库 GPG 公钥全部导入失败时是否允许降级为 trusted=yes（跳过包签名校验）
# 默认 false：构建直接失败。离线环境请将公钥放到 src/mysql/mysql_pubkey.asc；仅临时排障时设为 true
MYSQL_ALLOW_INSECURE_APT=false

# 宿主机 → 容器 MySQL 端口映射
MYSQL_HOST_PORT=3306

# MySQL 宿主机端口绑定地址（容器间访问走 docker 网络，不受影响）
#   127.0.0.1 = 仅本机访问（默认；./up.sh 启动 MySQL 时可交互选择）
#   0.0.0.0   = 对外开放（需配合防火墙/安全组限制来源）
# 非交互覆盖：./up.sh mysql --mysql-bind-host 0.0.0.0
MYSQL_BIND_HOST=127.0.0.1

# MySQL 日志目录（容器内挂载为 /var/log/mysql）
MYSQL_LOG_DIR=../../logs/mysql

# ------------------------------------------
# 基础资源限制（开发环境沿用此处的 limit + reservation）
# 由 compose/stacks/databases.yaml 直接引用，prod.yaml 覆盖
# ------------------------------------------

# MySQL CPU 上限（开发环境默认：4 核）
MYSQL_LIMITS_CPU=4

# MySQL 内存上限（开发环境默认：32G，注意生产环境会被 MYSQL_PROD_LIMITS_MEMORY 覆盖）
MYSQL_LIMITS_MEMORY=32G

# MySQL 内存预留（开发环境默认：4G）
MYSQL_RESERVATIONS_MEMORY=4G


# ==========================================
# 生产环境资源配置（按 mysql-prod.cnf 的 buffer_pool=16G 反推）
# ==========================================
# 本项目 MySQL 生产档（build/mysql/<版本>/config/conf.d/mysql-prod.cnf）将
# innodb_buffer_pool_size 固定为 16G，因此容器内存上限必须覆盖：
#   buffer_pool(16G) + 非池内存(performance_schema、redo/undo、300 连接
#   per-thread buffer，合计约 4~5G) + 安全余量(约 3G)
# 若把 innodb_buffer_pool_size 调小，可同步下调本项；pool 远小于内存时
# 可按 pool ≤ memory × 0.6 粗算。部署于更高配置服务器时请按比例上调。
# ------------------------------------------

# 生产环境 MySQL 副本数
# 固定 container_name + 宿主机 MYSQL_HOST_PORT 时须保持为 1
# 多副本需配合 MySQL 主从 / MGR / ProxySQL 等方案
MYSQL_PROD_REPLICAS=1

# 生产环境 MySQL CPU 上限（8 核 × 50%）
MYSQL_PROD_LIMITS_CPU=4

# 生产环境 MySQL 内存上限（= 16G buffer_pool + 非池内存 ≈5G + 余量 ≈3G）
# 仅由 compose/overlays/prod.yaml 引用，非生产环境（dev/wsl）不生效。
# 历史值 12G < buffer_pool 16G，会导致池无法分配完整、存在 OOM 风险，故上调。
MYSQL_PROD_LIMITS_MEMORY=24G

# 生产环境 MySQL CPU 预留（limit 的 50%）
MYSQL_PROD_RESERVATIONS_CPU=2

# 生产环境 MySQL 内存预留（≈ buffer_pool + 关键缓存）
# = innodb_buffer_pool_size(16G) + redo/undo/performance_schema 等关键缓存(≈2G)
# 须满足 buffer_pool ≤ reservation ≤ limit(24G)。
# 注意：单机 docker compose 下 deploy.resources.reservations 仅作调度提示，
# 不改变容器 cgroup 限额（实际限额见 MYSQL_PROD_LIMITS_MEMORY）；Swarm/K8s 下生效。
MYSQL_PROD_RESERVATIONS_MEMORY=18G


# ==========================================
# 开发环境资源配置
# ==========================================
# 开发环境 limit 由上方 MYSQL_LIMITS_* 提供，本节只覆盖 reservations。
# ------------------------------------------

# 开发环境 MySQL CPU 预留（仅做最小预留，避免调度器把它视为重负载）
MYSQL_DEV_RESERVATIONS_CPU=0.1

# 开发环境 MySQL 内存预留
MYSQL_DEV_RESERVATIONS_MEMORY=256M
