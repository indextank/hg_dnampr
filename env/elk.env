# ==========================================
# ELK Stack 配置
#
# 唯一版本开关：ELK_BUILD_VERSION（对应 build/elk/<该值>/）
# 具体小版本由 derive_elk_build_ver 自动解析（Docker Hub / GitHub），
# 并缓存安装包到 src/elk/（同系列只保留一份）。
#
# 下载地址模板（版本号由解析结果填充）：
#   - https://artifacts.elastic.co/downloads/elasticsearch/elasticsearch-<ELK_VERSION>-linux-x86_64.tar.gz
#   - https://artifacts.elastic.co/downloads/kibana/kibana-<ELK_VERSION>-linux-x86_64.tar.gz
#   - https://artifacts.elastic.co/downloads/logstash/logstash-<ELK_VERSION>-linux-x86_64.tar.gz
#   - https://release.infinilabs.com/analysis-ik/stable/elasticsearch-analysis-ik-<ELK_VERSION>.zip
#   - https://release.infinilabs.com/analysis-pinyin/stable/elasticsearch-analysis-pinyin-<ELK_VERSION>.zip
# 官方编排参考：
#   - https://github.com/elastic/dockerfiles/tree/9.5
#   - https://github.com/elastic/dockerfiles/tree/9.4
# ==========================================
# 可选：8.19 / 9.4 / 9.5；择优默认当前仓库已支持的最新系列
# 注意：已有 8.x 数据时须先升级到 8.19 并通过 Upgrade Assistant，且先做 snapshot；
#       ES 数据目录升级到 9.x 后不可回退到 8.x。
ELK_BUILD_VERSION=9.5

# ==========================================
# Elasticsearch配置
# https://hub.docker.com/_/elasticsearch
# ==========================================
ELASTICSEARCH_HOST_PORT=9333
ELASTICSEARCH_HOST_PORT_S=9300
ELASTICSEARCH_PLUGINS=analysis-ik,analysis-icu

# Elasticsearch 数据持久化子目录名
# 完整路径 = ${DATA_PATH_HOST}/${ELASTICSEARCH_DATA_SUBDIR}（由 Compose 运行时拼装）
#   默认 → /data/volume_data/elasticsearch
# 如需覆盖完整路径，可在 .env / elk.prod.env 中显式赋值 ELASTICSEARCH_DATA_PATH
ELASTICSEARCH_DATA_SUBDIR=elasticsearch

# ==========================================
# Kibana配置
# ==========================================
KIBANA_HOST_PORT=56001
KIBANA_I18N_LOCALE=zh-CN

KIBANA_PUBLIC_BASE_URL=http://127.0.0.1:56001
KIBANA_BASE_PATH=

# ==========================================
# Logstash配置
# ==========================================
LOGSTASH_HOST_PORT_C=9600
LOGSTASH_HOST_PORT_S=5044
LOGSTASH_HOST_PORT_TCP=5000
LOGSTASH_HOST_PORT_HTTP=8050
LOGSTASH_WORKERS=2
LOGSTASH_BATCH_SIZE=125
LOGSTASH_BATCH_DELAY=50
