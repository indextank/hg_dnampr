# 复制为 php-runtime.local.env 后填写应用运行时变量。
# 该文件只注入 PHP Web 容器，不应放数据库管理员/root 凭据。
# php-runtime.local.env 已被 .gitignore 忽略。

APP_ENV=production
APP_DEBUG=false

# 使用最小权限的应用账号，而不是数据库管理员账号。
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=<change_me>
DB_USERNAME=<change_me>
DB_PASSWORD=<change_me>

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<change_me>
