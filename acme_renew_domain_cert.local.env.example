# ==========================================
# acme_renew_domain_cert.sh 私有配置模板
# ==========================================
# 用法：
#   1. 复制为 acme_renew_domain_cert.local.env（已被 .gitignore 忽略，禁止入库）
#   2. 填入真实凭据
#
# 加载优先级（高 → 低）：
#   按域名加密保存的凭据 > 系统环境变量 > 本文件
#   本文件只填充"当前为空"的变量，不会覆盖已存在的系统环境变量。
#   脚本不再内置任何默认密钥；默认解析商（阿里云 / Cloudflare）的凭据缺失时，
#   签发流程会提示改用 HTTP 验证，或为当前域名单独配置解析商凭据。
#
# 注意：
#   - 值含空格时必须加引号，例如：CF_Account_ID="ab cd"
#   - 只允许填写下列变量名，其他变量会被忽略并提示
#   - 脚本执行 acme.sh 时需要这些变量处于导出状态（脚本内部已 export）

# ---- 阿里云 DNS（acme.sh 插件 dns_ali）----
# https://ram.console.aliyun.com/manage/ak
Ali_Key=""
Ali_Secret=""

# ---- Cloudflare DNS（acme.sh 插件 dns_cf）----
# https://dash.cloudflare.com/profile/api-tokens
CF_Token=""
CF_Account_ID=""

# ---- 其他解析商（可选，手动配置流程会按域名加密保存，一般无需写在这里）----
# 支持：dns_dp / dns_jd / dns_gd / dns_namecheap / dns_namesilo / dns_porkbun /
#       dns_dgon / dns_vultr / dns_linode / dns_gcore / dns_duckdns / dns_dynv6 / dns_aws
# 例如腾讯云 DNSPod：
#DP_Id=""
#DP_Key=""

# ---- HTTP 验证站点根目录（可选）----
# 选择 HTTP 方式验证时使用；其 /.well-known/acme-challenge/ 必须能被公网访问
# 未设置时脚本按 /data/wwwroot → /var/www/html → /usr/share/nginx/html 顺序自动探测
#ACME_HTTP_WEBROOT="/data/wwwroot"

# ---- 证书颁发机构（CA）自动评估（可选）----
# 默认自动评估，顺序：沿用已有证书的 CA → Let's Encrypt → ZeroSSL → 其他（需 EAB）
# 如需强制指定，填 acme.sh 的 --server 短名：letsencrypt / zerossl / actalis / sslcom / google
#ACME_CA=""

# 需 EAB 的 CA（Actalis / SSL.com / Google）必须提供下列凭据，否则不会进入候选
# 申请入口在各 CA 控制台；ZeroSSL 由 acme.sh 用注册邮箱自动获取，无需填写
#ACME_EAB_KID=""
#ACME_EAB_HMAC_KEY=""

# ---- 按域名凭据库目录（可选）----
# 默认 ~/.hg_acme_dns（内含 master.key 与 domains/<根域名>.cred）
# 更换目录会使已保存凭据无法解密，除非同时迁移 master.key
#ACME_CRED_STORE_DIR="$HOME/.hg_acme_dns"
